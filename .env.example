# ---- Gmail (recommended) ----
# The Gmail address the photos are sent FROM
GMAIL_USER=yourname@gmail.com
# A 16-character App Password from https://myaccount.google.com/apppasswords
# (NOT your normal Gmail password; spaces are fine)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Default recipient shown in the app
DEFAULT_TO=uzairkamal@yahoo.com

PORT=3000

# Set to true to build emails without sending them (for testing)
DRY_RUN=false

# ---- Other providers (only used if GMAIL_USER is empty) ----
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@yahoo.com
# SMTP_PASS=your-app-password
# MAIL_FROM="InvoMail <you@yahoo.com>"
