# Server
PORT=3000

# Default recipient shown in the UI
DEFAULT_TO=uzairkamal@yahoo.com

# SMTP settings (example: Gmail with an App Password, or Yahoo/Outlook SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM="InvoMail <you@example.com>"

# Set to true to skip real sending and just log the email (useful for testing)
DRY_RUN=false
