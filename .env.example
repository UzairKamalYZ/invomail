# ---- Where every invoice goes (fixed: the app cannot send anywhere else) ----
MAIL_TO=uzairkamal@yahoo.com

# Subject and message of every email. {date} = today's date, {count} = number of photos.
# Use \n for a new line in the message.
MAIL_SUBJECT="Invoice {date}"
MAIL_BODY="Hello,\n\nPlease find the invoice attached.\n\nKind regards"

# pdf = one PDF with all photos (recommended), image = separate JPEG files
SEND_FORMAT=pdf

# ---- Gmail account the emails are sent FROM ----
GMAIL_USER=yourname@gmail.com
# A 16-character App Password from https://myaccount.google.com/apppasswords
# (NOT your normal Gmail password; spaces are fine)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

PORT=3000

# Set to true to build emails without sending them (for testing)
DRY_RUN=false

# ---- Other providers (only used if GMAIL_USER is empty) ----
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@yahoo.com
# SMTP_PASS=your-app-password
# MAIL_FROM="InvoMail <you@yahoo.com>"
